---
import { tagSlug } from "../lib/posts";

interface Props {
  tags: string[];
  /** Highlights this tag and adds an "all" link back to the blog. */
  active?: string;
  showAll?: boolean;
}

const { tags, active, showAll = false } = Astro.props;
---

<ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
  {
    showAll && (
      <li>
        <a href="/blog" class:list={["link", !active && "text-fg"]}>
          [all]
        </a>
      </li>
    )
  }
  {
    tags.map((tag) => (
      <li>
        <a
          href={`/blog/tags/${tagSlug(tag)}`}
          class:list={["link", tag === active && "text-fg"]}
        >
          #{tag}
        </a>
      </li>
    ))
  }
</ul>
