---
import { site } from "../site";

const greetings = ["hello, i'm diljit.", "welcome.", "what's up?"];
---

<section class="hero relative overflow-hidden" data-hero>
  <canvas data-hero-canvas aria-hidden="true" class="absolute inset-0 size-full"></canvas>

  <div class="wrap relative py-24 md:py-36">
    <p class="rise text-sm text-muted" style="--i: 0">
      <span class="text-accent">&gt;</span>
      <span class="sr-only">{greetings[0]}</span>
      <span aria-hidden="true" data-scramble={JSON.stringify(greetings)}>{greetings[0]}</span><span
        aria-hidden="true"
        class="cursor">_</span
      >
    </p>

    <h1
      class="rise mt-6 flex flex-wrap items-center gap-x-3 gap-y-4 text-3xl font-bold tracking-tight sm:text-4xl md:text-5xl"
      style="--i: 1"
      data-keycaps
    >
      <kbd class="key" data-key="Control">Ctrl</kbd>
      <span class="text-muted">+</span>
      <kbd class="key" data-key="Alt">Alt</kbd>
      <span class="text-muted">+</span>
      <button type="button" class="key key-primary" data-key="Build">Build.</button>
    </h1>

    <p class="rise mt-8 max-w-xl text-base" style="--i: 2">
      I build things that work and sometimes things that almost do. Either way,
      I'm having fun pushing buttons until something cool happens.
    </p>

    <p class="rise mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm" style="--i: 3">
      <a href="/#projects" class="link text-fg">[see projects]</a>
      <a href="/blog" class="link text-fg">[read the blog]</a>
      <a href={site.contact} target="_blank" rel="noopener" class="link text-fg">[say hi]</a>
    </p>

    <p class="rise mt-10 hidden text-xs text-muted md:block" style="--i: 4">
      psst: hold ctrl + alt, or click anywhere.
    </p>
  </div>
</section>

<style>
  /* Keep the field quiet behind the text and fade it out at the bottom. */
  canvas {
    mask-image:
      linear-gradient(to bottom, #000 65%, transparent),
      linear-gradient(to right, rgb(0 0 0 / 0.3) 25%, #000 75%);
    mask-composite: intersect;
  }

  /* Keycaps: a hard shadow for depth that collapses when pressed. */
  .key {
    display: inline-block;
    padding: 0.3em 0.55em;
    border: 1px solid var(--line);
    border-radius: 0.3em;
    background: var(--surface);
    box-shadow: 0 0.14em 0 var(--line);
    font: inherit;
    line-height: 1.2;
    transition:
      transform 90ms ease-out,
      box-shadow 90ms ease-out;
  }

  .key-primary {
    border-color: var(--primary);
    background: var(--primary);
    box-shadow: 0 0.14em 0 color-mix(in srgb, var(--primary) 60%, #000);
    color: #fff;
    cursor: pointer;
  }

  .key.is-down,
  .key-primary:active {
    transform: translateY(0.14em);
    box-shadow: 0 0 0 transparent;
  }

  .cursor {
    animation: blink 1.1s steps(2) infinite;
  }

  /* Content slides up one line at a time on load. */
  .rise {
    animation: rise 600ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 90ms + 100ms);
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>

<script>
  import { initAsciiField } from "../scripts/ascii-field";
  import { initKeycaps } from "../scripts/keycaps";
  import { initScramble } from "../scripts/scramble";

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const canvas = hero?.querySelector<HTMLCanvasElement>("[data-hero-canvas]");
  const keycaps = hero?.querySelector<HTMLElement>("[data-keycaps]");
  const greeting = hero?.querySelector<HTMLElement>("[data-scramble]");

  if (hero && canvas) {
    const field = initAsciiField(canvas);

    // Click anywhere in the hero (except links and keys) to make a ripple.
    hero.addEventListener("click", (event) => {
      if (!(event.target as HTMLElement).closest("a, button")) {
        field.ripple(event.clientX, event.clientY);
      }
    });

    // Pressing "Build" ripples out from the key itself.
    if (keycaps) {
      initKeycaps(keycaps, (key) => {
        const box = key.getBoundingClientRect();
        field.ripple(box.left + box.width / 2, box.top + box.height / 2);
      });
    }
  }

  if (greeting) initScramble(greeting);
</script>
