---
import PostLayout from "../../layouts/PostLayout.astro";
import { getPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      newer: posts[index - 1],
      older: posts[index + 1],
    },
  }));
}
---

<PostLayout {...Astro.props} />
