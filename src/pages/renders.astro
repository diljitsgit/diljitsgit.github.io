---
import Gallery from "../components/Gallery.astro";
import PageHeader from "../components/PageHeader.astro";
import renders from "../data/renders";
import BaseLayout from "../layouts/BaseLayout.astro";

const lead = "Blender work from the past three years: cars, furniture, sculpts and challenge entries.";
---

<BaseLayout title="3D Renders" description={lead}>
  <div class="wrap py-14 md:py-20">
    <PageHeader title="3D Renders." lead={lead} />
    <Gallery images={renders} />
  </div>
</BaseLayout>
