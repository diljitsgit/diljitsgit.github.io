---
import { render } from "astro:content";
import TagList from "../components/TagList.astro";
import { formatDate, type Post, postUrl, readingTime } from "../lib/posts";
import { site } from "../site";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, date, updated, tags } = post.data;
const { Content } = await render(post);

// Tells search engines this page is an article, who wrote it and when.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: { "@type": "Person", name: site.name, url: Astro.site },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site),
  keywords: tags.join(", "),
};
---

<BaseLayout title={title} description={description} type="article" publishedTime={date}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <article class="wrap py-14 md:py-20">
    <a href="/blog" class="link text-sm">[&larr; all posts]</a>

    <header class="mb-10 mt-8 border-b border-line pb-8">
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{title}</h1>
      <p class="mt-4 text-sm text-muted">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span> · updated {formatDate(updated)}</span>}
        <span> · {readingTime(post)}</span>
      </p>
      {tags.length > 0 && <div class="mt-3"><TagList tags={tags} /></div>}
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      (newer || older) && (
        <nav aria-label="More posts" class="mt-14 grid gap-4 border-t border-line pt-8 text-sm sm:grid-cols-2">
          {older ? (
            <a href={postUrl(older)} class="group">
              <span class="text-muted">&larr; older</span>
              <span class="block font-bold group-hover:text-accent">{older.data.title}</span>
            </a>
          ) : <span />}
          {newer && (
            <a href={postUrl(newer)} class="group sm:text-right">
              <span class="text-muted">newer &rarr;</span>
              <span class="block font-bold group-hover:text-accent">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
